# Telegram bot token from @BotFather
BOT_TOKEN=123456:replace_me
# Telegram numeric user ID of the bot owner
OWNER_ID=123456789
# Log channel ID for user actions
LOG_CHANNEL_ID=-1003864916255
# Peek API concurrent requests (1..20)
PEEK_CONCURRENCY=1
# Gift request delay in seconds (default: 5)
GIFT_REQUEST_DELAY=5
# On Railway, mount a Volume at /data and keep this path
DATABASE_PATH=/data/bot_database.db
# Optional proxy, e.g. socks5://user:pass@host:port
# PROXY_URL=
