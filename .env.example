# Telegram bot token from @BotFather
BOT_TOKEN=123456:replace_me
# Telegram numeric user ID of the bot owner
OWNER_ID=8564624250
# Log channel ID for user actions
LOG_CHANNEL_ID=-1003864916255
# Peek API concurrent requests (1..20)
PEEK_CONCURRENCY=1
# Gift request delay for the legacy Peek scanner (seconds)
GIFT_REQUEST_DELAY=5
# MTProto chat scanner intentionally uses adaptive 2.5-5.5s per profile
# and 8-18s breaks after batches. Telegram FloodWait is always respected.
# On Railway, mount a Volume at /data and keep this path
DATABASE_PATH=/data/bot_database.db
# Optional proxy, e.g. socks5://user:pass@host:port
# PROXY_URL=

# Pre-authorized Telethon account. No phone/code login is used by the bot.
PARSER_SESSION_STRING=PASTE_TELETHON_STRING_SESSION_HERE
TG_API_ID=2040
TG_API_HASH=PASTE_TELEGRAM_API_HASH_HERE

# Parser speed (seconds between checked profiles)
PARSER_DELAY_MIN=0.8
PARSER_DELAY_MAX=1.8
PARSER_BATCH_DELAY_MIN=4
PARSER_BATCH_DELAY_MAX=8

# Hidden-member chat history discovery (optional)
# Number of Telegram messages loaded per history request.
PARSER_HISTORY_BATCH=300
# Delay between history batches, seconds.
PARSER_HISTORY_DELAY_MIN=0.8
PARSER_HISTORY_DELAY_MAX=1.8

# Hidden-chat scheduler safety: don't let one chat consume an entire round
# while yielding only users already scanned.
PARSER_MAX_SKIPS_PER_CHAT_ROUND=100
PARSER_MAX_IDLE_ROUNDS=8

# DEMO Gift Offer simulator (does NOT transfer Stars/Gram)
# Custom emoji ID is optional; easiest setup is to send `.эмодзи <custom emoji>` to the bot as owner.
OFFER_CUSTOM_EMOJI_ID=
# Your Telegr.ph instruction page for the "How to transfer?" button.
OFFER_HELP_URL=
# Optional fallback emoji alternative if OFFER_CUSTOM_EMOJI_ID is set manually.
# OFFER_CUSTOM_EMOJI_ALT=🎁

# CryptoBot / Crypto Pay API token (create in @CryptoBot -> Crypto Pay -> My Apps)
CRYPTO_PAY_API_TOKEN=
